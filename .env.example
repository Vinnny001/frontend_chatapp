# Where the two backends live. For the Android emulator use http://10.0.2.2:<port>;
# for a real phone use your computer's LAN IP (e.g. http://192.168.1.20:5050).
VITE_API_URL=http://localhost:5050
VITE_REALTIME_URL=http://localhost:5051

# Optional TURN server so calls connect across strict NATs / mobile networks.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
