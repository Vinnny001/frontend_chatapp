# Where the two backends live. For the Android emulator use http://10.0.2.2:<port>;
# for a real phone use your computer's LAN IP (e.g. http://192.168.1.20:5050).
VITE_API_URL=http://localhost:5050
VITE_REALTIME_URL=http://localhost:5051

# Optional TURN server so calls connect across strict NATs / mobile networks.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Link included in invite messages (your Vercel site or Play Store page)
# VITE_INVITE_URL=https://your-app.vercel.app

# Chat backup to Google Drive on the web: a "Web application" OAuth client ID from Google Cloud
# (with this site as an authorised JavaScript origin, and the Drive API enabled). The Android app
# needs no setting here, only an Android OAuth client for com.jujatech.chatapp with the signing SHA-1.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
